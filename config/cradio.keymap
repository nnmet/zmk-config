#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define SYM 2
#define EXT 1
#define NUM 3
#define FNS 4
#define FNS_E 5
#define AWSD 6
#define AWSD_E 7

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
};

&sk {
    release-after-ms = <500>;
};

&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_fns {
            timeout-ms = <50>;
            key-positions = <30 33>;
            bindings = <&sl FNS>;
        };
    };

    behaviors {
        comma: comma_morph {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp DOT>, <&kp COLON>;
            mods = <MOD_LSFT>;
        };

        dot: dot_morph {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp COMMA>, <&kp SEMICOLON>;
            mods = <MOD_LSFT>;
        };

        qexcl: qexcl_morph {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp QMARK>, <&kp EXCL>;
            mods = <MOD_LSFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp Q  &kp W  &kp F  &kp P  &kp B    &kp J  &kp L  &kp U    &kp Y      &kp Z
                &kp A  &kp R  &kp S  &kp T  &kp G    &kp M  &kp N  &kp E    &kp I      &kp O
                &none  &kp X  &kp C  &kp D  &kp V    &kp K  &kp H  &kp DOT  &kp COMMA  &none
                &mo EXT  &kp SPACE                   &mt LSHFT ESC  &mo SYM
            >;
        };

        sym {
            bindings = <
                &kp TILDE  &kp RPAR  &kp RBRC  &kp RBKT  &kp CARET    &kp STAR  &kp GRAVE  &kp SQT    &kp DQT    &kp PLUS
                &kp PRCNT  &kp LPAR  &kp LBRC  &kp LBKT  &kp PIPE     &kp FSLH  &kp EQUAL  &kp UNDER  &kp COLON  &kp MINUS
                &none      &kp AMPS  &kp AT    &kp HASH  &kp DOLLR    &kp BSLH  &kp QMARK  &kp EXCL   &kp SEMI   &none
                &none  &trans                                         &none  &trans
            >;
        };

        ext {
            bindings = <
                &kp LS(TAB)  &kp LC(TAB)  &kp LG(LC(L)) &kp LG(LC(O))  &none    &none  &kp DEL   &kp BSPC   &kp RET    &kp TAB
                &sk LSHFT    &sk LCTRL    &sk LCMD      &sk LALT       &none    &none  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT
                &caps_word   &none        &none         &none          &none    &none  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END
                &trans  &none                                                   &none  &none
            >;
        };

        num {
            bindings = <
                &none      &none      &none     &none     &none    &kp STAR  &kp N4  &kp N5  &kp N6  &kp PLUS
                &kp LSHFT  &kp LCTRL  &kp LCMD  &kp LALT  &none    &kp FSLH  &kp N1  &kp N2  &kp N3  &kp MINUS
                &none      &none      &none     &none     &none    &none     &kp N7  &kp N8  &kp N9  &kp N0
                &none  &trans                                      &trans  &none
            >;
        };

        fns {
            bindings = <
                &mo FNS_E  &kp VOL_DN  &kp VOL_UP  &kp MUTE  &kp C_BRI_UP    &kp F10  &kp F4  &kp F5  &kp F6  &kp PSCRN
                &kp LSHFT  &kp LCTRL   &kp LCMD    &kp LALT  &kp C_BRI_DN    &kp F11  &kp F1  &kp F2  &kp F3  &kp none
                &none      &kp C_PREV  &kp C_NEXT  &kp C_PP  &none           &kp F12  &kp F7  &kp F8  &kp F9  &kp none
                &none  &none                                                 &none  &none
            >;
        };

        fns_e {
            bindings = <
                &trans  &none  &bt BT_CLR_ALL  &bt BT_CLR  &none          &none       &none  &none       &none       &to AWSD
                &none   &none  &none           &none       &sys_reset     &sys_reset  &none  &kp LOCK    &kp SLEEP   &none
                &none   &none  &none           &none       &bootloader    &none       &none  &bt BT_PRV  &bt BT_NXT  &none
                &none  &none                                              &none  &none
            >;
        };

        awsd {
            bindings = <
                &kp TAB    &kp Q  &kp W  &kp E  &kp R    &none  &none  &none  &none  &none
                &kp LSHFT  &kp A  &kp S  &kp D  &kp F    &none  &none  &none  &none  &none
                &kp LCTRL  &kp Z  &kp X  &kp C  &kp V    &none  &none  &none  &none  &none
                &mo AWSD_N  &kp SPACE                    &to BASE  &none
            >;
        };

        awsd_e {
            bindings = <
                &kp ESC  &kp N1  &trans  &kp N2  &kp N3    &none  &none  &none  &none  &none
                &kp N0   &trans  &trans  &trans  &kp N4    &none  &none  &none  &none  &none
                &kp N9   &kp N8  &kp N7  &kp N6  &kp N5    &none  &none  &none  &none  &none
                &trans  &none                              &none  &none
            >;
        };
    };
};
