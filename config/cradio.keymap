#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define SYM 1
#define EXT 2
#define NUM 3
#define FNS 4
#define FNS_E 5
#define AWSD 6
#define AWSD_E 7

#define TAPPING_TERM_MS 150

&lt {
    tapping-term-ms = <TAPPING_TERM_MS>;
};

&num_word {
    ignore-modifiers;
};

/ {
    behaviors {
        lt_num: lt_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <TAPPING_TERM_MS>;
            bindings = <&mo>, <&num_word>;
        };

        sg_macroy: behavior_macroy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <15>;
            bindings = <
                &macro_press &kp SPACE
                &macro_press &kp LCTRL
                &macro_pause_for_release
                &macro_release &kp SPACE
                &macro_release &kp LCTRL
            >;
        };

        sg_macroz: behavior_macroz {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &macro_press &kp SPACE
                &macro_wait_time 20
                &macro_press &kp LCTRL
                &macro_pause_for_release
                &macro_release &kp SPACE
                &macro_release &kp LCTRL
            >;
        };

        sg_macro: behavior_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <
                &macro_press &kp SPACE
                &macro_wait_time 10
                &macro_press &kp LCTRL
                &macro_pause_for_release
                &macro_release &kp SPACE
                &macro_release &kp LCTRL
            >;
        };

        sg_macrox: behavior_macrox {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &macro_press &kp SPACE
                &macro_press &kp LCTRL
                &macro_pause_for_release
                &macro_release &kp SPACE
                &macro_release &kp LCTRL
            >;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_fns {
            timeout-ms = <50>;
            key-positions = <30 33>;
            bindings = <&sl FNS>;
        };

        sg_combo {
            timeout-ms = <50>;   
            key-positions = <10 31>;
            bindings = <&sg_macro>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp B  &kp L  &kp D  &kp W  &none    &kp K_CANCEL  &kp F  &kp O    &kp U      &kp J
                &kp N  &kp R  &kp T  &kp S  &kp G    &kp Y         &kp H  &kp E    &kp A      &kp I
                &kp Z  &kp Q  &kp M  &kp C  &kp V    &kp K         &kp P  &kp DOT  &kp COMMA  &kp X
                &lt_num EXT NUM  &kp SPACE           &none  &lt SYM ESC
            >;
        };

        sym {
            bindings = <
                &kp TILDE  &kp RPAR  &kp RBRC  &kp RBKT  &kp CARET    &kp STAR  &kp GRAVE  &kp SQT    &kp DQT    &kp PLUS
                &kp PRCNT  &kp LPAR  &kp LBRC  &kp LBKT  &kp PIPE     &kp FSLH  &kp EQUAL  &kp UNDER  &kp COLON  &kp MINUS
                &none      &kp AMPS  &kp AT    &kp HASH  &kp DLLR     &kp BSLH  &kp QMARK  &kp EXCL   &kp SEMI   &none
                &none  &trans                                         &none  &trans
            >;
        };

        ext {
            bindings = <
                &none        &kp LG(LC(L))  &kp LG(LC(O))  &none      &none         &none    &kp DEL   &kp BSPC   &kp RET    &none
                &sk LSHFT    &sk LCTRL      &sk LCMD       &sk LALT   &caps_word    &kp TAB  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT
                &none        &none          &none          &none      &none         &none    &kp HOME  &kp PG_DN  &kp PG_UP  &kp END
                &trans  &none                                                       &none  &none
            >;
        };

        num {
            bindings = <
                &none      &none      &kp MINUS  &kp PLUS  &none      &trans     &kp N4  &kp N5  &kp N6  &none
                &kp LSHFT  &kp LCTRL  &kp LCMD   &kp LALT  &kp DOT    &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp N0
                &none      &none      &kp FSLH   &kp STAR  &none      &none      &kp N7  &kp N8  &kp N9  &none
                &none  &trans                                         &none  &trans
            >;
        };

        fns {
            bindings = <
                &mo FNS_E  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &kp C_BRI_UP    &none  &kp F4  &kp F5  &kp F6  &kp F10
                &kp LSHFT  &kp LCTRL     &kp LCMD      &kp LALT    &kp C_BRI_DN    &none  &kp F1  &kp F2  &kp F3  &kp F11
                &kp PSCRN  &kp C_PREV    &kp C_NEXT    &kp C_PP    &none           &none  &kp F7  &kp F8  &kp F9  &kp F12
                &trans  &none                                                      &none  &trans
            >;
        };

        fns_e {
            bindings = <
                &trans  &none  &bt BT_CLR_ALL  &bt BT_CLR  &none          &none        &none  &none       &none       &to AWSD
                &none   &none  &none           &none       &sys_reset     &sys_reset   &none  &bt BT_PRV  &bt BT_NXT  &none
                &none   &none  &none           &none       &bootloader    &bootloader  &none  &none       &none       &none
                &none  &none                                              &none  &none
            >;
        };

        awsd {
            bindings = <
                &kp TAB    &kp Q  &kp W  &kp E  &kp R    &none  &none  &none  &none  &none
                &kp LSHFT  &kp A  &kp S  &kp D  &kp F    &none  &none  &none  &none  &none
                &kp LCTRL  &kp Z  &kp X  &kp C  &kp V    &none  &none  &none  &none  &none
                &mo AWSD_E  &kp SPACE                    &to BASE  &none
            >;
        };

        awsd_e {
            bindings = <
                &kp ESC  &sg_macroy  &trans  &sg_macroz  &kp N3    &none  &none  &none  &none  &none
                &sg_macro   &trans  &trans  &trans  &kp N4    &none  &none  &none  &none  &none
                &sg_macrox   &kp N8  &kp N7  &kp N6  &kp N5    &none  &none  &none  &none  &none
                &trans  &none                                 &none  &none
            >;
        };
    };
};