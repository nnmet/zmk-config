#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define SYM 1
#define EXT 2
#define NUM 3
#define FNS 4
#define FNS_E 5
#define AWSD 6
#define AWSD_E 7

#define TAPPING_TERM_MS 150

&lt {
    tapping-term-ms = <TAPPING_TERM_MS>;
};

&num_word {
    ignore-modifiers;
};

/ {
    behaviors {
        lt_num: lt_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <TAPPING_TERM_MS>;
            bindings = <&mo>, <&num_word>;
        };
    };

    // num n permiti ctrl+0?

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp Q  &kp W  &kp F  &kp P  &kp B    &kp J  &kp L  &kp U      &kp Y    &kp Z
                &kp A  &kp R  &kp S  &kp T  &kp G    &kp M  &kp N  &kp E      &kp I    &kp O
                &none  &kp X  &kp C  &kp D  &kp V    &kp K  &kp H  &kp COMMA  &kp DOT  &none
                &lt_num EXT NUM  &kp SPACE           &lt FNS ESC  &lt SYM K_CANCEL
            >;
        };

        sym {
            bindings = <
                &kp TILDE  &kp RPAR  &kp RBRC  &kp RBKT  &kp CARET    &kp STAR  &kp GRAVE  &kp SQT    &kp DQT    &kp PLUS
                &kp PRCNT  &kp LPAR  &kp LBRC  &kp LBKT  &kp PIPE     &kp FSLH  &kp EQUAL  &kp UNDER  &kp COLON  &kp MINUS
                &none      &kp AMPS  &kp AT    &kp HASH  &kp DLLR     &kp BSLH  &kp QMARK  &kp EXCL   &kp SEMI   &none
                &none  &trans                                         &none  &trans
            >;
        };

        ext {
            bindings = <
                &none        &kp LG(LC(L))  &kp LG(LC(O))  &none      &none         &none    &kp DEL   &kp BSPC   &kp RET    &none
                &sk LSHFT    &sk LCTRL      &sk LCMD       &sk LALT   &caps_word    &kp TAB  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT
                &none        &none          &none          &none      &none         &kp END  &kp HOME  &kp PG_DN  &kp PG_UP  &none
                &trans  &none                                                       &none  &none
            >;
        };

        num {
            bindings = <
                &none      &none      &kp MINUS  &kp PLUS  &none      &none   &kp N4  &kp N5  &kp N6  &none
                &kp LSHFT  &kp LCTRL  &kp LCMD   &kp LALT  &kp DOT    &kp N0  &kp N1  &kp N2  &kp N3  &none
                &none      &none      &kp FSLH   &kp STAR  &none      &none   &kp N7  &kp N8  &kp N9  &none
                &none  &trans                                         &trans  &trans
            >;
        };

        fns {
            bindings = <
                &mo FNS_E  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &kp C_BRI_UP    &kp F10  &kp F4  &kp F5  &kp F6  &kp PSCRN
                &kp LSHFT  &kp LCTRL     &kp LCMD      &kp LALT    &kp C_BRI_DN    &kp F11  &kp F1  &kp F2  &kp F3  &none
                &none      &kp C_PREV    &kp C_NEXT    &kp C_PP    &none           &kp F12  &kp F7  &kp F8  &kp F9  &none
                &trans  &none                                                      &none  &trans
            >;
        };

        fns_e {
            bindings = <
                &trans  &none  &bt BT_CLR_ALL  &bt BT_CLR  &none          &none        &none  &none       &none       &to AWSD
                &none   &none  &none           &none       &sys_reset     &sys_reset   &none  &bt BT_PRV  &bt BT_NXT  &none
                &none   &none  &none           &none       &bootloader    &bootloader  &none  &none       &none       &none
                &none  &none                                              &none  &none
            >;
        };

        awsd {
            bindings = <
                &kp TAB    &kp Q  &kp W  &kp E  &kp R    &none  &none  &none  &none  &none
                &kp LSHFT  &kp A  &kp S  &kp D  &kp F    &none  &none  &none  &none  &none
                &kp LCTRL  &kp Z  &kp X  &kp C  &kp V    &none  &none  &none  &none  &none
                &mo AWSD_E  &kp SPACE                    &to BASE  &none
            >;
        };

        awsd_e {
            bindings = <
                &kp ESC  &kp N1  &trans  &kp N2  &kp N3    &none  &none  &none  &none  &none
                &kp N0   &trans  &trans  &trans  &kp N4    &none  &none  &none  &none  &none
                &kp N9   &kp N8  &kp N7  &kp N6  &kp N5    &none  &none  &none  &none  &none
                &trans  &none                              &none  &none
            >;
        };
    };
};
