#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define SYM 1
#define EXT 2
#define NUM 3
#define FNS 4
#define FNS_E 5
#define AWSD 6
#define AWSD_E 7

#define HTD_TAPPING_TERM 200
#define TAPPING_TERM 80
#define LT_TAPPING_TERM 175
#define SMOD_TAPPING_TERM 175
#define NUM_TAPPING_TERM 200
#define NUM_PRIOR_IDLE 125

#define SMOD(mod) &smod mod mod

&lt {
    tapping-term-ms = <LT_TAPPING_TERM>;
};

&sk {
    lazy;
    release-after-ms = <2000>;
};

&num_word {
    ignore-modifiers;
};

/ {
    behaviors {
        lt_num: lt_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TAPPING_TERM>;
            bindings = <&mo>, <&num_word>;
        };

        td_cancel_caps: td_cancel_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <HTD_TAPPING_TERM>;
            bindings = <&kp K_CANCEL>, <&caps_word>;
        };

        htd_cancel_caps: htd_sft_cancel_caps {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            quick-tap-ms = <HTD_TAPPING_TERM>;
            tapping-term-ms = <HTD_TAPPING_TERM>;
            bindings = <&kp>, <&td_cancel_caps>;
        };

        num_hold: num_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <NUM_TAPPING_TERM>;
            require-prior-idle-ms = <NUM_PRIOR_IDLE>;
            bindings = <&mo>, <&kp>;
        };

        smod: sticky_or_held_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <SMOD_TAPPING_TERM>;
            bindings = <&kp>, <&sk>;
        };

        undo_redo: undo_redo {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(Z)>, <&kp LC(LS(Z))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        alt_tab: alt_tab {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
            ignored-key-positions = <22>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_fns {
            timeout-ms = <100>;
            key-positions = <30 33>;
            bindings = <&sl FNS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp B  &kp L            &kp D  &kp W  &none    &none  &kp F  &kp O      &kp U    &kp J
                &kp N  &kp R            &kp T  &kp S  &kp G    &kp Y  &kp H  &kp E      &kp A    &kp I
                &kp Z  &num_hold NUM Q  &kp M  &kp C  &kp V    &kp K  &kp P  &kp COMMA  &kp DOT  &kp X
                &lt_num EXT NUM  &kp SPACE           &htd_cancel_caps LSHIFT 0  &lt SYM ESC
            >;
        };

        sym {
            bindings = <
                &kp PRCNT  &kp AT    &kp HASH  &kp DLLR  &none       &none      &kp PLUS   &kp MINUS  &kp UNDER  &kp PIPE
                &kp LPAR   &kp LBKT  &kp LBRC  &kp FSLH  &kp BSLH    &kp EXCL   &kp QMARK  &kp DQT    &kp COLON  &kp EQUAL
                &kp RPAR   &kp RBKT  &kp RBRC  &kp STAR  &kp AMPS    &kp TILDE  &kp GRAVE  &kp SQT    &kp SEMI   &kp CARET
                &none  &trans                                        &none  &trans
            >;
        };

        ext {
            bindings = <
                &alt_tab     &kp RET      &kp BSPC    &kp DEL     &none        &none  &none     &none      &none      &none
                SMOD(LSHFT)  SMOD(LCTRL)  SMOD(LCMD)  SMOD(LALT)  &kp TAB      &none  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT
                &undo_redo   &kp LC(A)    &kp LC(X)   &kp LC(C)   &kp LC(V)    &none  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END
                &trans  &none                                                  &none  &trans
            >;
        };

        num {
            bindings = <
                &none     &kp RET    &kp BSPC   &none     &none        &none  &kp N1  &kp N2  &kp N3  &none
                &kp PLUS  &kp MINUS  &kp STAR   &kp FSLH  &kp EQUAL    &none  &kp N4  &kp N5  &kp N6  &kp N0
                &none     &none      &kp COMMA  &kp DOT   &none        &none  &kp N7  &kp N8  &kp N9  &none
                &none  &trans                                          &none  &kp K_CANCEL
            >;
        };

        fns {
            bindings = <
                &mo FNS_E  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &none           &none  &kp F1  &kp F2  &kp F3  &kp F10
                &kp LSHFT  &kp LCTRL     &kp LCMD      &kp LALT    &kp C_BRI_UP    &none  &kp F4  &kp F5  &kp F6  &kp F11
                &kp PSCRN  &kp C_PREV    &kp C_NEXT    &kp C_PP    &kp C_BRI_DN    &none  &kp F7  &kp F8  &kp F9  &kp F12
                &trans  &none                                                      &none  &trans
            >;
        };

        fns_e {
            bindings = <
                &trans  &none  &bt BT_CLR_ALL  &bt BT_CLR  &none          &none        &none  &none       &none       &to AWSD
                &none   &none  &none           &none       &sys_reset     &sys_reset   &none  &bt BT_PRV  &bt BT_NXT  &none
                &none   &none  &none           &none       &bootloader    &bootloader  &none  &none       &none       &none
                &none  &none                                              &none  &none
            >;
        };

        awsd {
            bindings = <
                &kp TAB    &kp Q  &kp W  &kp E  &kp R    &none  &none  &none  &none  &none
                &kp LSHFT  &kp A  &kp S  &kp D  &kp F    &none  &none  &none  &none  &none
                &kp LCTRL  &kp Z  &kp X  &kp C  &kp V    &none  &none  &none  &none  &none
                &mo AWSD_E  &kp SPACE                    &none  &to BASE
            >;
        };

        awsd_e {
            bindings = <
                &kp ESC  &kp N1  &trans  &kp N2  &kp N3    &none  &none  &none  &none  &none
                &kp N0   &trans  &trans  &trans  &kp N4    &none  &none  &none  &none  &none
                &kp N9   &kp N8  &kp N7  &kp N6  &kp N5    &none  &none  &none  &none  &none
                &trans  &none                              &none  &none
            >;
        };
    };
};
