#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define SYM 1
#define EXT 2
#define NUM 3
#define FNS 4
#define FNS_E 5
#define AWSD 6
#define AWSD_E 7

&lt {
    tapping-term-ms = <150>;
};

&sk {
    lazy;
    release-after-ms = <2000>;
};

&num_word {
    ignore-modifiers;
};

/ {
    behaviors {
        lt_num: lt_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <100>;
            bindings = <&mo>, <&num_word>;
        };

        mt_word: mt_word {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <
                &mt LSFT K_CANCEL
                &caps_word
            >;
        };

        alt_tab: alt_tab {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
            ignored-key-positions = <22>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_fns {
            timeout-ms = <100>;
            key-positions = <30 33>;
            bindings = <&sl FNS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp B  &kp L  &kp D  &kp W  &none    &none  &kp F  &kp O    &kp U      &kp J
                &kp N  &kp R  &kp T  &kp S  &kp G    &kp Y  &kp H  &kp E    &kp A      &kp I
                &kp Z  &kp Q  &kp M  &kp C  &kp V    &kp K  &kp P  &kp DOT  &kp COMMA  &kp X
                &lt_num EXT NUM  &kp SPACE           &mt_word  &lt SYM ESC
            >; 
        };

        sym {
            bindings = <
                &kp STAR   &kp RPAR  &kp RBRC  &kp RBKT  &none        &none     &kp GRAVE  &kp SQT    &kp DQT    &kp PLUS
                &kp PRCNT  &kp LPAR  &kp LBRC  &kp LBKT  &kp PIPE     &kp FSLH  &kp EQUAL  &kp UNDER  &kp COLON  &kp MINUS
                &kp CARET  &kp AMPS  &kp AT    &kp HASH  &kp DLLR     &kp BSLH  &kp QMARK  &kp EXCL   &kp SEMI   &kp TILDE
                &none  &trans                                         &none  &trans
            >;
        };

        ext {
            bindings = <
                &kp LG(LC(L))  &kp LG(LC(O))  &kp BSPC     &kp DEL   &none    &none  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END
                &sk LSHFT      &sk LCTRL      &sk LCMD     &sk LALT  &none    &none  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT
                &none          &none          &kp LS(TAB)  &alt_tab  &none    &none  &kp RET   &kp TAB    &none      &none
                &trans  &none                                                 &none  &none
            >;
        };

        num {
            bindings = <
                &kp MINUS  &kp PLUS   &kp STAR  &kp FSLH   &none    &none   &kp N4  &kp N5  &kp N6  &none
                &kp LSHFT  &kp LCTRL  &kp LCMD  &kp LALT   &none    &none   &kp N1  &kp N2  &kp N3  &kp N0
                &none      &none      &kp DOT   &kp EQUAL  &none    &none   &kp N7  &kp N8  &kp N9  &none
                &none  &trans                                       &trans  &trans
            >;
        };

        fns {
            bindings = <
                &mo FNS_E  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &none           &none  &kp F4  &kp F5  &kp F6  &kp F10
                &kp LSHFT  &kp LCTRL     &kp LCMD      &kp LALT    &kp C_BRI_UP    &none  &kp F1  &kp F2  &kp F3  &kp F11
                &kp PSCRN  &kp C_PREV    &kp C_NEXT    &kp C_PP    &kp C_BRI_DN    &none  &kp F7  &kp F8  &kp F9  &kp F12
                &trans  &none                                                      &none  &trans
            >;
        };

        fns_e {
            bindings = <
                &trans  &none  &bt BT_CLR_ALL  &bt BT_CLR  &none          &none        &none  &none       &none       &to AWSD
                &none   &none  &none           &none       &sys_reset     &sys_reset   &none  &bt BT_PRV  &bt BT_NXT  &none
                &none   &none  &none           &none       &bootloader    &bootloader  &none  &none       &none       &none
                &none  &none                                              &none  &none
            >;
        };

        awsd {
            bindings = <
                &kp TAB    &kp Q  &kp W  &kp E  &kp R    &none  &none  &none  &none  &none
                &kp LSHFT  &kp A  &kp S  &kp D  &kp F    &none  &none  &none  &none  &none
                &kp LCTRL  &kp Z  &kp X  &kp C  &kp V    &none  &none  &none  &none  &none
                &mo AWSD_E  &kp SPACE                    &to BASE  &none
            >;
        };

        awsd_e {
            bindings = <
                &kp ESC  &kp N1  &trans  &kp N2  &kp N3    &none  &none  &none  &none  &none
                &kp N0   &trans  &trans  &trans  &kp N4    &none  &none  &none  &none  &none
                &kp N9   &kp N8  &kp N7  &kp N6  &kp N5    &none  &none  &none  &none  &none
                &trans  &none                              &none  &none
            >;
        };
    };
};