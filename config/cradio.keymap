#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define NUM 3
#define FNS 4
#define AWSD 5
#define AWSD_NUM 6

/ {
    behaviors {
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            label = "BASE";
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I      &kp O    &kp P
                &kp A  &kp S  &kp D  &kp F  &kp G    &kp H  &kp J  &kp K      &kp L    &kp SQT
                &kp Z  &kp X  &kp C  &kp V  &kp B    &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH
                &mo NAV  &kp SPACE                   &mt LSHF ESC  &mo SYM
            >;
        };

        nav {
            label = "NAV";
            bindings = <
                &kp TAB  &none  &none  &none  &none    &none  &none     &kp END    &kp HOME   &none
                &none    &none  &none  &none  &none    &none  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT
                &none    &none  &none  &none  &none    &none  &none     &kp PG_DN  &kp PG_UP  &none
                &trans  &mo GAMER                      &none  &none
            >;
        };

        sym {
            label = "SYM";
            bindings = <
                &none  &none     &none     &none     &none    &none  &none  &none  &none  &none
                &none  &kp LPAR  &kp LBKT  &kp LBRC  &none    &none  &none  &none  &none  &none
                &none  &none     &none     &none     &none    &none  &none  &none  &none  &none
                &kp RET  &kp BSPC                             &none  &trans
            >;
        };

        num {
            label = "NUM";
            bindings = <
                &none  &none  &none  &none  &none    &none   &kp N7  &kp N8  &kp N9  &none
                &none  &none  &none  &none  &none    &none   &kp N4  &kp N5  &kp N6  &none
                &none  &none  &none  &none  &none    &kp N0  &kp N1  &kp N2  &kp N3  &none
                &none  &none                         &none  &none
            >;
        };

        fns {
            label = "FNS";
            bindings = <
                &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
                &none  &none                         &none  &none
            >;
        };

        awsd {
            label = "AWSD";
            bindings = <
                &kp TAB    &kp Q  &kp W  &kp E  &kp R    &none  &none  &none  &none  &none
                &kp LSHFT  &kp A  &kp S  &kp D  &kp F    &none  &none  &none  &none  &none
                &kp LCTRL  &kp Z  &kp X  &kp C  &kp V    &none  &none  &none  &none  &none
                &lt AWSD_NUM ESC  &kp SPACE              &mo BASE  &none
            >;
        };

        awsd_num {
            label = "AWSD_NUM";
            bindings = <
                &none  &kp N4  &kp N5  &kp N6  &none            &none  &none  &none  &none  &none
                &none  &kp N1  &kp N2  &kp N3  &kp LC(SPACE)    &none  &none  &none  &none  &none
                &none  &none   &none   &none   &none            &none  &none  &none  &none  &none
                &trans  &none                                   &none  &none
            >;
        };
    };
};
